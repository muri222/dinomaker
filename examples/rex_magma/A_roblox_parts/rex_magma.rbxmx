 <Item class="Script" referent="RBX00001385"><Properties>
 <string name="Name">DinoAnimator</string>
 <ProtectedString name="Source"><![CDATA[--[[
	DinoAnimator (Script, RunContext = Client) — gerado pelo dinomaker.

	Toca as animações embutidas na pasta "Animations" (KeyframeSequence)
	escrevendo direto em Motor6D.Transform. Não precisa publicar nada.

	Estado automático:
	  Death  -> Humanoid morreu (Health <= 0)
	  Fly    -> atributo Flying = true (só dinos com asas)
	  Run    -> velocidade > meio caminho entre WalkSpeed e RunSpeed
	  Walk   -> velocidade > 0.5
	  Idle   -> parado
	Ações (uma vez): servidor faz model:SetAttribute("Action", "Attack"|"Roar"|"Hit"|"Eat")
	e incrementa "ActionNonce" (use o ModuleScript DinoAPI).
]]

local RunService = game:GetService("RunService")

local model = script.Parent
local hum = model:WaitForChild("Humanoid", 15)
local root = model:WaitForChild("HumanoidRootPart", 15)
local folder = model:WaitForChild("Animations", 15)
if not (hum and root and folder) then
	return
end

local FADE = 0.18

-- Motor6D por nome da parte filha (Part1)
local motors = {}
for _, d in ipairs(model:GetDescendants()) do
	if d:IsA("Motor6D") and d.Part1 then
		motors[d.Part1.Name] = d
	end
end

-- KeyframeSequence -> lista ordenada de {t, poses}
local clips = {}
local function loadClip(kfs)
	local keys = {}
	for _, kf in ipairs(kfs:GetChildren()) do
		if kf:IsA("Keyframe") then
			local poses = {}
			for _, p in ipairs(kf:GetDescendants()) do
				if p:IsA("Pose") and p.Weight > 0 and motors[p.Name] then
					poses[p.Name] = p.CFrame
				end
			end
			table.insert(keys, { t = kf.Time, poses = poses })
		end
	end
	table.sort(keys, function(a, b)
		return a.t < b.t
	end)
	if #keys == 0 then
		return nil
	end
	return { keys = keys, length = keys[#keys].t, loop = kfs.Loop, name = kfs.Name }
end
for _, kfs in ipairs(folder:GetChildren()) do
	if kfs:IsA("KeyframeSequence") then
		clips[kfs.Name] = loadClip(kfs)
	end
end

local function sample(clip, t, out)
	local keys = clip.keys
	local n = #keys
	if clip.loop and clip.length > 0 then
		t = t % clip.length
	elseif t >= clip.length then
		t = clip.length
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = math.floor((lo + hi) / 2)
		if keys[mid].t <= t then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = keys[lo], keys[hi]
	local span = b.t - a.t
	local alpha = 0
	if span > 0 then
		alpha = math.clamp((t - a.t) / span, 0, 1)
	end
	for name, cfa in pairs(a.poses) do
		local cfb = b.poses[name] or cfa
		out[name] = cfa:Lerp(cfb, alpha)
	end
	return out
end

-- estado
local current, currentT, speedScale = nil, 0, 1
local prevPose, fadeT = nil, 0
local action, actionT, actionPlays = nil, 0, 0
local dead = false
local lastPose = {}

local function play(name)
	if current == name then
		return
	end
	if not clips[name] then
		return
	end
	prevPose = {}
	for k, v in pairs(lastPose) do
		prevPose[k] = v
	end
	fadeT = 0
	current = name
	currentT = 0
end

local function startAction(name)
	if not clips[name] or dead then
		return
	end
	prevPose = {}
	for k, v in pairs(lastPose) do
		prevPose[k] = v
	end
	fadeT = 0
	action = name
	actionT = 0
	actionPlays = (name == "Eat") and 2 or 1
end

model:GetAttributeChangedSignal("ActionNonce"):Connect(function()
	local a = model:GetAttribute("Action")
	if type(a) == "string" and a ~= "" then
		startAction(a)
	end
end)

hum.Died:Connect(function()
	dead = true
	action = nil
	play("Death")
end)

local function chooseBase()
	if dead or hum.Health <= 0 then
		dead = true
		return "Death", 1
	end
	if model:GetAttribute("Flying") and clips.Fly then
		return "Fly", 1
	end
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local ws = model:GetAttribute("WalkSpeed") or 8
	local rs = model:GetAttribute("RunSpeed") or ws * 2
	if speed > (ws + rs) * 0.5 and clips.Run then
		return "Run", math.clamp(speed / rs, 0.5, 2)
	elseif speed > 0.5 and clips.Walk then
		return "Walk", math.clamp(speed / ws, 0.5, 2)
	end
	return "Idle", 1
end

local camera = workspace.CurrentCamera
local accum = 0

RunService.PreSimulation:Connect(function(dt)
	if not model.Parent then
		return
	end
	-- LOD: longe da câmera atualiza menos
	accum = accum + dt
	local cam = workspace.CurrentCamera or camera
	if cam then
		local dist = (cam.CFrame.Position - root.Position).Magnitude
		local interval = dist > 300 and 0.2 or (dist > 150 and 0.066 or 0)
		if accum < interval then
			return
		end
	end
	local step = accum
	accum = 0

	local base, rate = chooseBase()
	if base ~= current and not (current == "Death" and dead) then
		play(base)
	end
	speedScale = rate
	currentT = currentT + step * speedScale
	fadeT = fadeT + step

	local pose = {}
	if action and not dead then
		actionT = actionT + step
		local clip = clips[action]
		if actionT >= clip.length then
			actionPlays = actionPlays - 1
			if actionPlays <= 0 then
				action = nil
				prevPose = {}
				for k, v in pairs(lastPose) do
					prevPose[k] = v
				end
				fadeT = 0
			else
				actionT = 0
			end
		end
		if action then
			sample(clips[action], actionT, pose)
		end
	end
	if not action then
		sample(clips[current], currentT, pose)
	end

	local w = math.clamp(fadeT / FADE, 0, 1)
	for name, cf in pairs(pose) do
		local m = motors[name]
		if m then
			local final = cf
			if prevPose and w < 1 and prevPose[name] then
				final = prevPose[name]:Lerp(cf, w)
			end
			m.Transform = final
			lastPose[name] = final
		end
	end
end)
]]></ProtectedString>
 <bool name="Disabled">false</bool>
 <token name="RunContext">2</token>
 </Properties>
 </Item>
 <Item class="Script" referent="RBX00001386"><Properties>
 <string name="Name">DinoBrain</string>
 <ProtectedString name="Source"><![CDATA[--[[
	DinoBrain (Script, RunContext = Server) — gerado pelo dinomaker.

	Atributos do Model (editáveis no Studio):
	  WalkSpeed / RunSpeed  velocidades que batem com a passada da animação
	  Wander (bool)         passeia sozinho perto do ponto inicial (teste rápido)
	  WanderRadius          raio do passeio
	  Action / ActionNonce  dispara ações (use DinoAPI.Play)
	  Flying (bool)         toca a animação Fly (dinos com asas)
]]

local model = script.Parent
local hum = model:WaitForChild("Humanoid")
local root = model:WaitForChild("HumanoidRootPart")
local API = require(model:WaitForChild("DinoAPI"))

hum.WalkSpeed = model:GetAttribute("WalkSpeed") or hum.WalkSpeed

pcall(function()
	root:SetNetworkOwner(nil)
end)

local home = root.Position
local rng = Random.new()

local function wander()
	while model.Parent and hum.Health > 0 do
		if model:GetAttribute("Wander") then
			local r = model:GetAttribute("WanderRadius") or 40
			local target = home + Vector3.new(rng:NextNumber(-r, r), 0, rng:NextNumber(-r, r))
			if rng:NextNumber() < 0.25 then
				API.Run(model, target)
			else
				API.Walk(model, target)
			end
			local done = false
			local conn = hum.MoveToFinished:Connect(function()
				done = true
			end)
			local t0 = os.clock()
			while not done and os.clock() - t0 < 10 and model:GetAttribute("Wander") do
				task.wait(0.2)
			end
			conn:Disconnect()
			hum:MoveTo(root.Position)
			task.wait(rng:NextNumber(1.5, 4))
			local roll = rng:NextNumber()
			if roll < 0.3 then
				API.Play(model, "Roar")
				task.wait(2)
			elseif roll < 0.55 then
				API.Play(model, "Eat")
				task.wait(5)
			end
		else
			task.wait(1)
		end
	end
end

task.spawn(wander)
]]></ProtectedString>
 <bool name="Disabled">false</bool>
 <token name="RunContext">1</token>
 </Properties>
 </Item>
 <Item class="ModuleScript" referent="RBX00001387"><Properties>
 <string name="Name">DinoAPI</string>
 <ProtectedString name="Source"><![CDATA[--[[
	DinoAPI (ModuleScript) — gerado pelo dinomaker.

	local API = require(dino.DinoAPI)
	API.Play(dino, "Attack")   -- "Attack" | "Roar" | "Hit" | "Eat"
	API.Walk(dino, Vector3.new(10, 0, 0))
	API.Run(dino, Vector3.new(50, 0, 0))
	API.SetFlying(dino, true)  -- só dinos com asas
	API.Kill(dino)             -- toca "Death"
]]

local API = {}

function API.Play(model, action)
	model:SetAttribute("Action", action)
	model:SetAttribute("ActionNonce", (model:GetAttribute("ActionNonce") or 0) + 1)
end

function API.Walk(model, position)
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.WalkSpeed = model:GetAttribute("WalkSpeed") or 8
	hum:MoveTo(position)
end

function API.Run(model, position)
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.WalkSpeed = model:GetAttribute("RunSpeed") or 16
	hum:MoveTo(position)
end

function API.SetFlying(model, flying)
	model:SetAttribute("Flying", flying and true or false)
end

function API.Kill(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.Health = 0
end

return API
]]></ProtectedString>
 </Properties>
 </Item>
</Item>
</roblox>